# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# copied from node_modules by scripts/copy-maplibre-worker.mjs
/public/maplibre-gl-worker.mjs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees of other projects, never part of this repository
/.claude/worktrees/

# raw downloads for scripts/import-ecocrop.mjs (FAO EcoCrop); only the extract in src/data/ is committed
/data/raw/
